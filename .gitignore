# editors
.idea/
.vscode/

# python
*.egg-info/
*.py[cod]
__pycache__/
.venv/
/build/
/dist/

# tools
.coverage*
/htmlcov/
.testee/

# devenv / direnv
.devenv/
.direnv/

# gitman runtime state (lock, etc.)
.gitman/

# caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local working notes: loose scratch is untracked; tracked design docs live in .scratch/projects/
.scratch/*
!.scratch/projects/

# retired old-gitman code, kept for reference only
archive/

# machine-local agent state (per-machine permission grants; never shared)
.claude/settings.local.json

# Nix build output
/result
/result-*

# `.agents/` is machine-local: the devman central overlay owns it (a symlink
# to ~/.config/devman/projects/<p>/agents). Nothing under it is tracked — the
# router is generated by `repoman install-skills` and the pool skills are links.
# AGENTS.md and CLAUDE.md stay committed by design.
.agents
.envrc
